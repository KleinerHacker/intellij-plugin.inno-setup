<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>org.pcsoft.intellij.plugin.inno-setup</id>
    <name>Inno Setup</name>
    <description><![CDATA[
        Inno Setup plugin for all JetBrains IDEs, providing support for the Inno Setup scripting language.
        ]]></description>

    <depends>com.intellij.modules.lang</depends>
    <depends optional="true" config-file="plugin-kotlin.xml">org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Services -->
        <applicationService serviceImplementation="org.pcsoft.intellij.plugin.inno_setup.services.IssSpecService"/>
        <applicationService serviceImplementation="org.pcsoft.intellij.plugin.inno_setup.services.IssConstantService"/>
        <applicationService serviceImplementation="org.pcsoft.intellij.plugin.inno_setup.services.IssIsppService"/>

        <!-- File type -->
        <fileType name="Inno Setup Script"
                  implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.IssFileType"
                  language="ISS"
                  extensions="iss"/>

        <!-- Parser -->
        <lang.parserDefinition language="ISS"
            implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.parsing.IssParserDefinition"/>

        <!-- Syntax highlighting -->
        <lang.syntaxHighlighterFactory language="ISS"
            implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.parsing.IssHighlighterFactory"/>

        <!-- Semantic annotator -->
        <annotator language="ISS"
            implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.parsing.IssAnnotator"/>

        <!-- Error filter for [Code] and ISPP -->
        <highlightErrorFilter
            implementation="org.pcsoft.intellij.plugin.inno_setup.language.parsing.IssErrorFilter"/>

        <!-- Find Usages -->
        <lang.findUsagesProvider language="ISS"
            implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.navigation.IssFindUsagesProvider"/>

        <!-- Reference provider -->
        <psi.referenceContributor language="ISS"
            implementation="org.pcsoft.intellij.plugin.inno_setup.language.navigation.IssReferenceContributor"/>

        <!-- Typed handler (auto-popup after '[' and '{') -->
        <typedHandler
            implementation="org.pcsoft.intellij.plugin.inno_setup.language.editor.IssTypedHandler"/>

        <!-- Completion contributor -->
        <completion.contributor language="ISS"
            implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.completion.IssCompletionContributor"/>

        <!-- Brace matching: [], {}, () -->
        <lang.braceMatcher language="ISS"
            implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.editor.IssBraceMatcher"/>

        <!-- Quote handler: " -->
        <typedHandler
            implementation="org.pcsoft.intellij.plugin.inno_setup.language.editor.IssQuoteHandler"/>

        <!-- Code folding -->
        <lang.foldingBuilder language="ISS"
            implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.editor.IssCodeFoldingBuilder"/>

        <!-- Structure view -->
        <lang.psiStructureViewFactory language="ISS"
            implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.navigation.IssStructureViewFactory"/>

        <!-- Documentation provider -->
        <lang.documentationProvider language="ISS"
            implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.navigation.IssDocumentationProvider"/>

        <!-- Commenter (Ctrl+/) -->
        <lang.commenter language="ISS"
            implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.editor.IssCommenter"/>
    </extensions>

</idea-plugin>
