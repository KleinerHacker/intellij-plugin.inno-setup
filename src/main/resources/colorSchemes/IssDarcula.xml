<scheme name="Darcula" version="142" parent_scheme="Darcula">
    <attributes>
        <!-- Kotlin-extension-style blue for ISPP preprocessor directives / references (dark theme) -->
        <option name="ISS_PREPROCESSOR_DIRECTIVE">
            <value>
                <option name="FOREGROUND" value="56a8f5"/>
            </value>
        </option>
        <option name="ISS_ISPP_REFERENCE_NAME">
            <value>
                <option name="FOREGROUND" value="56a8f5"/>
                <option name="FONT_TYPE" value="2"/>
            </value>
        </option>
        <option name="ISS_DEFINE_NAME">
            <value>
                <option name="FONT_TYPE" value="2"/>
            </value>
        </option>
        <!-- `cm` keyword of {cm:…} — italic -->
        <option name="ISS_CM_PREFIX">
            <value>
                <option name="FONT_TYPE" value="2"/>
            </value>
        </option>
        <!-- Literal boolean (true/false/yes/no) misused in a #if/#elif condition — yellow -->
        <option name="ISS_BOOLEAN_LITERAL">
            <value>
                <option name="FOREGROUND" value="d7c26b"/>
            </value>
        </option>
        <!-- Unused elements (trailing semicolons, unused #define, empty sections) — gray -->
        <option name="ISS_UNUSED">
            <value>
                <option name="FOREGROUND" value="808080"/>
            </value>
        </option>
        <!-- Background tint for #include-pulled text in the effective-script view — dark translucent blue -->
        <option name="ISS_INCLUDE_SEGMENT_BACKGROUND">
            <value>
                <option name="BACKGROUND" value="2b3245"/>
            </value>
        </option>
    </attributes>
</scheme>
