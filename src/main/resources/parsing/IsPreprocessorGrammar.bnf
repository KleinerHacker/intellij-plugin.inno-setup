{
  parserClass="org.pcsoft.intellij.plugin.inno_setup.language.parser.preprocessor.parsing.parser.IsPreprocessorParser"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="IsPreprocessor"
  psiImplClassSuffix="Impl"
  psiPackage="org.pcsoft.intellij.plugin.inno_setup.language.parser.preprocessor.parsing.psi"
  psiImplPackage="org.pcsoft.intellij.plugin.inno_setup.language.parser.preprocessor.parsing.psi.impl"

  elementTypeHolderClass="org.pcsoft.intellij.plugin.inno_setup.language.parser.preprocessor.parsing.psi.IsPreprocessorTypes"
  elementTypeClass="org.pcsoft.intellij.plugin.inno_setup.language.parser.preprocessor.parsing.psi.IsPreprocessorElementType"
  tokenTypeClass="org.pcsoft.intellij.plugin.inno_setup.language.parser.preprocessor.parsing.psi.IsPreprocessorTokenType"

  tokens=[
    HASH        = "#"
    IDENTIFIER  = "regexp:[A-Za-z_][A-Za-z0-9_.\\-]*"
    NUMBER      = "regexp:[0-9]+(\.[0-9]+)*"
    QUOTE       = "\""
    STRING_PART = "regexp:[^\"{\r\n]+"
    VALUE_CHAR  = "regexp:[^\r\n{};:=\"()#\t ]"
    CRLF        = "regexp:\r?\n"
    LPAREN      = "("
    RPAREN      = ")"
    LBRACE      = "{"
    RBRACE      = "}"
    EQ          = "="
    COLON       = ":"
    SEMICOLON   = ";"
  ]
}

// Root: each injected fragment is one preprocessor line (#keyword rest...)
isppFile ::= directive? CRLF?

directive ::= HASH IDENTIFIER value? {
  pin=1
  mixin="org.pcsoft.intellij.plugin.inno_setup.language.parser.preprocessor.parsing.psi.impl.IsPreprocessorDirectiveMixinImpl"
  implements="org.pcsoft.intellij.plugin.inno_setup.language.parser.preprocessor.parsing.psi.IsPreprocessorDirectiveEx"
}

value ::= valueToken+

private valueToken ::= constant
                     | quotedString
                     | NUMBER
                     | IDENTIFIER
                     | VALUE_CHAR
                     | LPAREN | RPAREN
                     | EQ | COLON | SEMICOLON
                     | HASH

// "..." with optional embedded {constants}
quotedString ::= QUOTE (STRING_PART | constant)* QUOTE

// {app}, {#Name}, {reg:...}, etc. within ISPP values
constant     ::= LBRACE constantBody RBRACE
constantBody ::= (IDENTIFIER | NUMBER | VALUE_CHAR | COLON | HASH | EQ)*
