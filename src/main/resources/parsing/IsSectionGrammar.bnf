{
  parserClass="org.pcsoft.intellij.plugin.inno_setup.language.parser.section.parsing.parser.IsSectionParser"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="IsSection"
  psiImplClassSuffix="Impl"
  psiPackage="org.pcsoft.intellij.plugin.inno_setup.language.parser.section.parsing.psi"
  psiImplPackage="org.pcsoft.intellij.plugin.inno_setup.language.parser.section.parsing.psi.impl"

  elementTypeHolderClass="org.pcsoft.intellij.plugin.inno_setup.language.parser.section.parsing.psi.IsSectionTypes"
  elementTypeClass="org.pcsoft.intellij.plugin.inno_setup.language.parser.section.parsing.psi.IsSectionElementType"
  tokenTypeClass="org.pcsoft.intellij.plugin.inno_setup.language.parser.section.parsing.psi.IsSectionTokenType"

  tokens=[
    COMMENT          = "regexp:(;|//)[^\r\n]*"
    LBRACKET         = "["
    RBRACKET         = "]"
    LBRACE           = "{"
    RBRACE           = "}"
    LPAREN           = "("
    RPAREN           = ")"
    EQ               = "="
    COLON            = ":"
    SEMICOLON        = ";"
    HASH             = "#"
    HASH_LINE        = "regexp:#[^\r\n]*"
    CRLF             = "regexp:\r?\n"
    NUMBER           = "regexp:[0-9]+(\.[0-9]+)*"
    IDENTIFIER       = "regexp:[A-Za-z_][A-Za-z0-9_.\\-]*"
    QUOTE            = "\""
    STRING_PART      = "regexp:[^\"{\r\n]+"
    VALUE_CHAR       = "regexp:[^\r\n]"
  ]
}

issFile ::= item*

private item ::= block
               | preprocessorLine
               | comment
               | CRLF

// Stops recovery at the next line boundary, section header, or preprocessor directive.
// Only used where the first token AFTER a successful parse is always CRLF/LBRACKET/HASH
// (i.e. sectionHeader, preprocessorDirective).  Must NOT be applied to directiveEntry or
// parameterEntry because Grammar-Kit calls eatMore even on success, and an IDENTIFIER
// starting the next valid entry would be consumed as an error token.
private recover_line ::= !( CRLF | LBRACKET | HASH )

block ::= header CRLF? entry* {
  pin=1
}

header ::= LBRACKET title RBRACKET {
  pin=1
  recoverWhile="recover_line"
}
title  ::= IDENTIFIER

private entry ::= directiveEntry
                | parameterEntry
                | comment
                | CRLF

// [Setup]-style: Key=Value
// pin=2 commits after "Key ="; no recoverWhile to avoid consuming the next entry.
directiveEntry ::= directiveKey EQ paramValue CRLF? {
  pin=2
  mixin="org.pcsoft.intellij.plugin.inno_setup.language.parser.section.parsing.psi.impl.IsSectionDirectiveEntryMixinImpl"
  implements="org.pcsoft.intellij.plugin.inno_setup.language.parser.section.parsing.psi.IsSectionDirectiveEntryEx"
}
directiveKey   ::= IDENTIFIER

// [Files]-style: Key: Value; Key: Value
// pin=1 commits after first paramPair; no recoverWhile (same reason as directiveEntry).
// SEMICOLON? allows a trailing semicolon at end of line (e.g. "Flags: x;")
parameterEntry ::= paramPair (SEMICOLON paramPair)* SEMICOLON? CRLF? {
  pin=1
}
paramPair      ::= paramKey COLON paramValue {
  pin=2
  mixin="org.pcsoft.intellij.plugin.inno_setup.language.parser.section.parsing.psi.impl.IsSectionParamPairMixinImpl"
  implements="org.pcsoft.intellij.plugin.inno_setup.language.parser.section.parsing.psi.IsSectionParamPairEx"
}
paramKey       ::= IDENTIFIER

paramValue     ::= (constant | quotedString | NUMBER | IDENTIFIER | LPAREN | RPAREN | VALUE_CHAR)* {
  mixin="org.pcsoft.intellij.plugin.inno_setup.language.parser.section.parsing.psi.impl.IsSectionParamValueMixinImpl"
}

// "..." with optional embedded {constants}
quotedString   ::= QUOTE (STRING_PART | constant)* QUOTE

// {app}, {win}, {reg:HKLM\...}, {#AppVersion}, {%ENV|default}
constant     ::= LBRACE constantBody RBRACE
constantBody ::= (IDENTIFIER | NUMBER | VALUE_CHAR | COLON | HASH | EQ)* {
  mixin="org.pcsoft.intellij.plugin.inno_setup.language.parser.section.parsing.psi.impl.IsSectionConstantBodyMixinImpl"
}

private comment ::= COMMENT

// Preprocessor line: the entire #... line is captured as a single opaque token.
// The ISPP language is injected into this element by IsPreprocessorInjector.
preprocessorLine ::= HASH_LINE {
  mixin="org.pcsoft.intellij.plugin.inno_setup.language.parser.section.parsing.psi.impl.IsSectionPreprocessorLineMixinImpl"
  implements="com.intellij.psi.PsiLanguageInjectionHost"
}
