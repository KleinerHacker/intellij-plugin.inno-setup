<!-- Inno Setup language fragment (:language:script): the .iss/.isl/.ist language-level
     registrations (parser, highlighter, folding, brace matching, basic annotator, commenter, injector).
     File type registrations (<fileType>) and file icon providers live only in :plugin (plugin.xml) so
     that third-party plugins embedding :language:script do not inherit Inno Setup extension mappings.
     Pulled into the main plugin.xml via <xi:include>. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Parser / highlighting -->
        <lang.parserDefinition language="ISS"
                               implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.IsSectionParserDefinition"/>
        <lang.syntaxHighlighterFactory language="ISS"
                                       implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.IsSectionHighlighterFactory"/>
        <lang.parserDefinition language="IST"
                               implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.template.IsTemplateParserDefinition"/>
        <lang.syntaxHighlighterFactory language="IST"
                                       implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.template.IsTemplateHighlighterFactory"/>

        <!-- Semantic annotators -->
        <annotator language="ISS"
                   implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.IsSectionAnnotator"/>
        <annotator language="ISS"
                   implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.lang.IsLanguageAnnotator"/>

        <!-- Error filter for [Code] -->
        <highlightErrorFilter
                implementation="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.IsSectionErrorFilter"/>

        <!-- ISPP injector: injects ISPP language into IsSectionPreprocessorLine / template elements -->
        <multiHostInjector
                implementation="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.preprocessor.injection.IsPreprocessorInjector"/>

        <!-- Brace matching -->
        <lang.braceMatcher language="ISS"
                           implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.feature.editor.IsSectionBraceMatcher"/>
        <lang.braceMatcher language="IST"
                           implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.feature.editor.template.IsTemplateBraceMatcher"/>

        <!-- Code folding -->
        <lang.foldingBuilder language="ISS"
                             implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.feature.editor.section.IsSectionCodeFoldingBuilder"/>

        <!-- Commenter (Ctrl+/) -->
        <lang.commenter language="ISS"
                        implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.feature.editor.IsCommenter"/>

        <!-- Code formatter (Reformat Code): inline spacing around = : ; and [ ] -->
        <lang.formatter language="ISS"
                        implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.formatter.IsSectionFormattingModelBuilder"/>
        <!-- Post-format pass: blank line between sections, leading-key trimming, preprocessor operator spacing -->
        <postFormatProcessor
                implementation="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.formatter.IsFormatterPostFormatProcessor"/>
        <!-- Custom code-style settings factory (materialises IsSectionCodeStyleSettings on every settings) -->
        <codeStyleSettingsProvider
                implementation="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.formatter.IsSectionCodeStyleSettingsFactory"/>
        <!-- Code Style page + options (Settings ▸ Editor ▸ Code Style ▸ Inno Setup) -->
        <langCodeStyleSettingsProvider
                implementation="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.formatter.IsSectionCodeStyleSettingsProvider"/>

        <!-- Typed handlers: auto-popup after '[' and '{', quote handling, template typing -->
        <typedHandler
                implementation="org.pcsoft.intellij.plugin.inno_setup.script.language.feature.editor.section.IsSectionTypedHandler"/>
        <typedHandler
                implementation="org.pcsoft.intellij.plugin.inno_setup.script.language.feature.editor.IsQuoteHandler"/>
        <typedHandler
                implementation="org.pcsoft.intellij.plugin.inno_setup.script.language.feature.editor.template.IsTemplateTypedHandler"/>

        <!-- Color settings page -->
        <colorSettingsPage
                implementation="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.IsSectionColorSettingsPage"/>

        <!-- Persistent state storage for the Inno Setup installation path -->
        <applicationService
                serviceImplementation="org.pcsoft.intellij.plugin.inno_setup.script.settings.IsSettingsService"/>
    </extensions>
</idea-plugin>
