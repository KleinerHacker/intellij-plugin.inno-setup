{
  parserClass="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.IsSectionParser"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="IsSection"
  psiImplClassSuffix="Impl"
  psiPackage="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.psi"
  psiImplPackage="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.psi.impl"

  elementTypeHolderClass="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.psi.IsSectionTypes"
  elementTypeClass="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.psi.IsSectionElementType"
  tokenTypeClass="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.psi.IsSectionTokenType"

  tokens=[
    COMMENT          = "regexp:(;|//)[^\r\n]*"
    LBRACKET         = "["
    RBRACKET         = "]"
    LBRACE           = "{"
    RBRACE           = "}"
    LPAREN           = "("
    RPAREN           = ")"
    EQ               = "="
    COLON            = ":"
    SEMICOLON        = ";"
    HASH             = "#"
    HASH_LINE        = "regexp:#([^\r\n]*\\[ \t]*\r?\n)*[^\r\n]*"
    CRLF             = "regexp:\r?\n"
    NUMBER           = "regexp:[0-9]+(\.[0-9]+)*"
    IDENTIFIER       = "regexp:[A-Za-z_][A-Za-z0-9_.\\-]*"
    QUOTE            = "\""
    STRING_PART      = "regexp:[^\"{\r\n]+"
    VALUE_CHAR       = "regexp:[^\r\n]"
  ]
}

issFile ::= item*

// Top level also accepts bare directive/parameter entries (no preceding section header). A script that is
// pulled in via #include is often a fragment whose owning [Section] header lives in the including file (or
// is contributed by an #include of its own), so entries may legitimately appear before the first header.
// Per-line key/flag/value checks are skipped for such header-less entries (no containing section); the
// effective, #include-resolved script supplies the section context for mandatory-section/-directive checks.
private item ::= block
               | directiveEntry
               | parameterEntry
               | preprocessorLine
               | comment
               | CRLF

// Stops recovery at the next line boundary, section header, or preprocessor directive.
// Only used where the first token AFTER a successful parse is always CRLF/LBRACKET/HASH
// (i.e. sectionHeader, preprocessorDirective).  Must NOT be applied to directiveEntry or
// parameterEntry because Grammar-Kit calls eatMore even on success, and an IDENTIFIER
// starting the next valid entry would be consumed as an error token.
private recover_line ::= !( CRLF | LBRACKET | HASH )

block ::= header CRLF? entry* {
  pin=1
}

header ::= LBRACKET title RBRACKET {
  pin=1
  recoverWhile="recover_line"
}
title  ::= IDENTIFIER

private entry ::= directiveEntry
                | parameterEntry
                | comment
                | CRLF

// [Setup]-style: Key=Value
// pin=2 commits after "Key ="; no recoverWhile to avoid consuming the next entry.
directiveEntry ::= directiveKey EQ directiveValue CRLF? {
  pin=2
  mixin="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.psi.impl.IsSectionDirectiveEntryMixinImpl"
  implements="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.psi.IsSectionDirectiveEntryEx"
}
directiveKey   ::= IDENTIFIER

// A directive value runs to the end of the line, so — unlike a parameter value — it also
// accepts the COLON/SEMICOLON/EQ/HASH tokens as plain text. This keeps free-form, unquoted
// values (e.g. [CustomMessages]/[Messages] strings like "Additional icons:" or "Launch %1;
// then quit") from terminating the entry early and dropping the rest of the file from the parse.
// elementType=paramValue collapses it onto the IsSectionParamValue PSI type, so every
// IsSectionParamValue consumer (annotator, references, accessors) keeps working unchanged.
directiveValue ::= (constant | quotedString | NUMBER | IDENTIFIER | LPAREN | RPAREN | VALUE_CHAR | COLON | SEMICOLON | EQ | HASH)* {
  extends="paramValue"
  elementType="paramValue"
  mixin="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.psi.impl.IsSectionParamValueMixinImpl"
}

// [Files]-style: Key: Value; Key: Value
// pin=1 commits after first paramPair; no recoverWhile (same reason as directiveEntry).
// SEMICOLON? allows a trailing semicolon at end of line (e.g. "Flags: x;")
parameterEntry ::= paramPair (SEMICOLON paramPair)* SEMICOLON? CRLF? {
  pin=1
}
paramPair      ::= paramKey COLON paramValue {
  pin=2
  mixin="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.psi.impl.IsSectionParamPairMixinImpl"
  implements="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.psi.IsSectionParamPairEx"
}
paramKey       ::= IDENTIFIER

paramValue     ::= (constant | quotedString | NUMBER | IDENTIFIER | LPAREN | RPAREN | VALUE_CHAR)* {
  mixin="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.psi.impl.IsSectionParamValueMixinImpl"
}

// "..." with optional embedded {constants}
quotedString   ::= QUOTE (STRING_PART | constant)* QUOTE

// {app}, {win}, {reg:HKLM\...}, {#AppVersion}, {%ENV|default}
constant     ::= LBRACE constantBody RBRACE
constantBody ::= (IDENTIFIER | NUMBER | VALUE_CHAR | COLON | HASH | EQ)* {
  mixin="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.psi.impl.IsSectionConstantBodyMixinImpl"
}

private comment ::= COMMENT

// Preprocessor line: the entire #... line is captured as a single opaque token.
// The ISPP language is injected into this element by IsPreprocessorInjector.
preprocessorLine ::= HASH_LINE {
  mixin="org.pcsoft.intellij.plugin.inno_setup.script.language.parser.section.psi.impl.IsSectionPreprocessorLineMixinImpl"
  implements="com.intellij.psi.PsiLanguageInjectionHost"
}
