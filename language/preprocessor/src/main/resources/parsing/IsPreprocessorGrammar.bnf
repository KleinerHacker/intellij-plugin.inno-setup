{
  parserClass="org.pcsoft.intellij.plugin.inno_setup.preprocessor.language.parser.IsPreprocessorParser"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="IsPreprocessor"
  psiImplClassSuffix="Impl"
  psiPackage="org.pcsoft.intellij.plugin.inno_setup.preprocessor.language.parser.psi"
  psiImplPackage="org.pcsoft.intellij.plugin.inno_setup.preprocessor.language.parser.psi.impl"

  elementTypeHolderClass="org.pcsoft.intellij.plugin.inno_setup.preprocessor.language.parser.psi.IsPreprocessorTypes"
  elementTypeClass="org.pcsoft.intellij.plugin.inno_setup.preprocessor.language.parser.psi.IsPreprocessorElementType"
  tokenTypeClass="org.pcsoft.intellij.plugin.inno_setup.preprocessor.language.parser.psi.IsPreprocessorTokenType"

  tokens=[
    HASH        = "#"
    IDENTIFIER  = "regexp:[A-Za-z_][A-Za-z0-9_.\\-]*"
    NUMBER      = "regexp:[0-9]+(\.[0-9]+)*"
    QUOTE       = "\""
    STRING_PART = "regexp:[^\"{\r\n]+"
    VALUE_CHAR  = "regexp:[^\r\n\[\]{};:=\"()#\t ]"
    CRLF        = "regexp:\r?\n"
    LPAREN      = "("
    RPAREN      = ")"
    LBRACKET    = "["
    RBRACKET    = "]"
    LBRACE      = "{"
    RBRACE      = "}"
    EQ          = "="
    COLON       = ":"
    SEMICOLON   = ";"
    // Escapes of Inno Setup: "{{" is a literal "{", "" inside a string is a literal quote, and %n, %%, %1-%9,
    // %7d, %7c, %2c are the percent escapes (recognised inside strings).
    ESCAPED_LBRACE  = "{{"
    ESCAPED_QUOTE   = "\"\""
    ESCAPED_PERCENT = "regexp:%([n%1-9]|7[dDcC]|2[cC])"
  ]
}

// Root: each injected fragment is one preprocessor directive (#keyword rest...). The fragment may
// span several physical lines when a line ends with a backslash; the lexer reports such a line
// continuation as whitespace, so the grammar stays line oriented.
isppFile ::= directive? CRLF?

directive ::= HASH IDENTIFIER value? {
  pin=1
  mixin="org.pcsoft.intellij.plugin.inno_setup.preprocessor.language.parser.psi.impl.IsPreprocessorDirectiveMixinImpl"
  implements="org.pcsoft.intellij.plugin.inno_setup.preprocessor.language.parser.psi.IsPreprocessorDirectiveEx"
}

value ::= valueToken+

// ESCAPED_LBRACE, LBRACE and RBRACE come last, after `constant` has had its chance: "{{" is the escape of a
// literal "{", a "}" outside a constant is ordinary text, and an unclosed "{" falls back to plain text.
private valueToken ::= constant
                     | quotedString
                     | NUMBER
                     | IDENTIFIER
                     | VALUE_CHAR
                     | LPAREN | RPAREN
                     | LBRACKET | RBRACKET
                     | EQ | COLON | SEMICOLON
                     | HASH
                     | ESCAPED_LBRACE | LBRACE | RBRACE

// "..." with optional embedded {constants}; "{{", "" and the percent escapes are escapes inside the string
quotedString ::= QUOTE (STRING_PART | ESCAPED_LBRACE | ESCAPED_QUOTE | ESCAPED_PERCENT | constant)* QUOTE

// {app}, {#Name}, {reg:...}, etc. within ISPP values — and the `#for {Init; Cond; Incr}` header group.
// The body accepts arbitrary balanced expression tokens so a `#for {i = 0; i < 10; i++}` brace group does
// not produce spurious parse errors; nested `{…}` and quoted strings are matched recursively.
constant     ::= LBRACE constantBody RBRACE
constantBody ::= (IDENTIFIER | NUMBER | VALUE_CHAR | COLON | HASH | EQ | SEMICOLON
                 | LPAREN | RPAREN | LBRACKET | RBRACKET | quotedString | constant | ESCAPED_PERCENT)*
