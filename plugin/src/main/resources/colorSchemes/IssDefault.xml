<scheme name="Default" version="142" parent_scheme="Default">
    <attributes>
        <!-- Kotlin-extension-style blue for ISPP preprocessor directives / references (light theme) -->
        <option name="ISS_PREPROCESSOR_DIRECTIVE">
            <value>
                <option name="FOREGROUND" value="0000c0"/>
            </value>
        </option>
        <option name="ISS_ISPP_REFERENCE_NAME">
            <value>
                <option name="FOREGROUND" value="0000c0"/>
                <option name="FONT_TYPE" value="2"/>
            </value>
        </option>
        <option name="ISS_DEFINE_NAME">
            <value>
                <option name="FONT_TYPE" value="2"/>
            </value>
        </option>
        <!-- `cm` keyword of {cm:…} — italic -->
        <option name="ISS_CM_PREFIX">
            <value>
                <option name="FONT_TYPE" value="2"/>
            </value>
        </option>
        <!-- Literal boolean (true/false/yes/no) misused in a #if/#elif condition — yellow -->
        <option name="ISS_BOOLEAN_LITERAL">
            <value>
                <option name="FOREGROUND" value="a37a00"/>
            </value>
        </option>
        <!-- Unused elements (trailing semicolons, unused #define, empty sections) — gray -->
        <option name="ISS_UNUSED">
            <value>
                <option name="FOREGROUND" value="808080"/>
            </value>
        </option>
        <!-- Body of a provably skipped #if branch — dimmed, but still readable on a light background -->
        <option name="ISS_INACTIVE_BRANCH">
            <value>
                <option name="FOREGROUND" value="9a9a9a"/>
            </value>
        </option>
        <!-- Statically undecidable #if/#elif condition — blue wavy underline instead of a yellow warning -->
        <option name="ISS_UNDECIDABLE_CONDITION">
            <value>
                <option name="EFFECT_COLOR" value="0000c0"/>
                <option name="EFFECT_TYPE" value="2"/>
            </value>
        </option>
        <!-- Background tint for #include-pulled text in the effective-script view — light translucent blue -->
        <option name="ISS_INCLUDE_SEGMENT_BACKGROUND">
            <value>
                <option name="BACKGROUND" value="e8ecfb"/>
            </value>
        </option>
    </attributes>
</scheme>
