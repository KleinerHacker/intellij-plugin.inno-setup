<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin url="https://github.com/KleinerHacker/intellij-plugin.inno-setup"
             xmlns:xi="http://www.w3.org/2001/XInclude">
    <id>org.pcsoft.ij.plugin.inno-setup</id>
    <name>Inno Setup</name>
    <description><![CDATA[
        <p>
            Brings first-class language support for <a href="https://jrsoftware.org/isinfo.php">Inno Setup</a>
            installer scripts to the whole JetBrains IDE family. Inno Setup scripts (<code>.iss</code>) describe a
            complete Windows installer &mdash; files, registry keys, shortcuts, tasks, components and optional Pascal
            scripting. This plugin turns the IDE into a full-featured editor for them, so you no longer have to switch
            to the Inno Setup Compiler to write, navigate and validate your scripts.
        </p>

        <h3>Editing &amp; understanding scripts</h3>
        <ul>
            <li><b>Syntax highlighting</b> &mdash; sections, directive keys, parameters, constants
                (<code>{app}</code>, <code>{autopf}</code>, &hellip;) and embedded Pascal <code>[Code]</code> blocks are
                coloured distinctly. Colours are fully customisable in <i>Settings &rarr; Editor &rarr; Color Scheme</i>.</li>
            <li><b>Context-aware code completion</b> &mdash; section names, directive keys, parameter keys, known flag
                values and constants are suggested as you type, with automatic pop-ups after typing <code>[</code> or
                <code>{</code>.</li>
            <li><b>Inline documentation</b> &mdash; hover over any section, directive, parameter or preprocessor
                directive to read its description without leaving the editor.</li>
            <li><b>Error checking &amp; validation</b> &mdash; unknown sections, invalid directives/parameters and
                unrecognised constants are flagged directly in the editor, including constants embedded inside quoted
                strings.</li>
            <li><b>Structure view &amp; navigation bar</b> &mdash; get a bird&rsquo;s-eye overview of every section and
                its entries and jump straight to them.</li>
            <li><b>Code folding</b> &mdash; collapse whole sections and long parameter entries independently.</li>
            <li><b>Brace &amp; quote matching</b> &mdash; auto-closes and highlights matching <code>{}</code>,
                <code>[]</code>, <code>()</code> and <code>"</code>.</li>
            <li><b>Line commenting</b> &mdash; comment and uncomment lines with the usual shortcut.</li>
            <li><b>Move statements</b> &mdash; move parameter entries up and down with the standard shortcut.</li>
            <li><b>Inlay hints</b> &mdash; language flag icons are shown inline next to <code>Languages:</code> values
                and in <code>[Languages]</code> / <code>[LangOptions]</code> entries.</li>
        </ul>

        <h3>References &amp; refactoring</h3>
        <ul>
            <li><b>Reference resolution &amp; go-to</b> &mdash; navigate between <code>Name:</code> declarations and
                their usages in <code>Tasks:</code>, <code>Components:</code> and <code>Types:</code> parameters, between
                <code>[CustomMessages]</code> entries and their <code>{cm:&hellip;}</code> usages, and between
                <code>[Languages]</code> names and their language-specific message keys.</li>
            <li><b>Find usages</b> &mdash; list every reference to a name, custom message or preprocessor define.</li>
            <li><b>Rename refactoring</b> &mdash; safely rename a declaration and all of its references in one step,
                including <code>{#Name}</code> usages of preprocessor defines.</li>
        </ul>

        <h3>Preprocessor (ISPP)</h3>
        <ul>
            <li>Preprocessor directives (<code>#define</code>, <code>#include</code>, <code>#if</code>, &hellip;) are
                parsed, highlighted, completed and documented just like script code.</li>
            <li><code>#define</code> constants resolve, can be renamed and have their usages found across the script.</li>
            <li><b>Include handling</b> &mdash; inline an <code>#include</code> directly into the script, or extract a
                selection into a new include file, via intention actions. View the fully <code>#include</code>-resolved
                effective script in a read-only tab from the context menu.</li>
        </ul>

        <h3>Building &amp; running</h3>
        <ul>
            <li><b>Compile from the IDE</b> &mdash; build a single <code>.iss</code> script via ISCC from the context
                menu, or have scripts compiled automatically when the project is built. Compiler output is shown in the
                console with foldable detail lines.</li>
            <li><b>Run installers</b> &mdash; a dedicated run configuration and a gutter icon next to the
                <code>[Setup]</code> section let you launch a compiled installer directly.</li>
            <li><b>Settings</b> &mdash; configure the Inno Setup installation location IDE-wide and build options per
                project under <i>Build, Execution, Deployment &rarr; Inno Setup</i>.</li>
        </ul>

        <h3>Additional file types</h3>
        <ul>
            <li><b>Language files (<code>.isl</code>)</b> &mdash; Inno Setup translation files are recognised,
                highlighted and validated alongside your scripts, with their own new-file template.</li>
            <li><b>Template files (<code>.ist</code>)</b> &mdash; free-text fragments for use as alternative
                <code>#include</code> targets, with brace matching and section completion.</li>
        </ul>

        <p>
            Works in IntelliJ IDEA, PyCharm, CLion, Rider, WebStorm, GoLand, RubyMine, DataGrip and every other
            IntelliJ-platform IDE.
        </p>

        <p>
            Full documentation &mdash; including a complete reference for every Inno Setup section and parameter &mdash;
            is available at
            <a href="https://kleinerhacker.github.io/intellij-plugin.inno-setup/">https://kleinerhacker.github.io/intellij-plugin.inno-setup/</a>.
        </p>

        <p>
            Copyright &copy; KleinerHacker alias Pfeiffer C Soft 2026. Licensed under the Apache License, Version 2.0.
        </p>
        ]]></description>
    <version>0.5.0</version>
    <vendor url="https://github.com/KleinerHacker/intellij-plugin.inno-setup">KleinerHacker alias Pfeiffer C Soft
    </vendor>

    <resource-bundle>messages.PluginBundle</resource-bundle>

    <depends>com.intellij.modules.lang</depends>

    <!-- Language-level registrations live with their module and are pulled in here. -->
    <xi:include href="/META-INF/inno-setup-preprocessor.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/inno-setup-script.xml" xpointer="xpointer(/idea-plugin/*)"/>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File types (.iss/.isl/.ist) — registered here in :plugin so language modules stay embeddable -->
        <fileType name="Inno Setup Script"
                  implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.file_type.IsScriptFileType"
                  language="ISS"
                  extensions="iss"/>
        <fileType name="Inno Setup Language"
                  implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.file_type.lang.IsLanguageFileType"
                  language="ISS"
                  extensions="isl"/>
        <fileType name="Inno Setup Template"
                  implementationClass="org.pcsoft.intellij.plugin.inno_setup.script.language.file_type.template.IsTemplateFileType"
                  language="IST"
                  extensions="ist"/>

        <!-- ISL file icon: base icon + language-flag overlay -->
        <fileIconProvider
                implementation="org.pcsoft.intellij.plugin.inno_setup.script.language.file_type.lang.IsLanguageFileIconProvider"/>
        <!-- Build output: dedicated tool-window console + balloon notifications -->
        <toolWindow id="Inno Setup"
                    anchor="bottom"
                    canCloseContents="false"
                    factoryClass="org.pcsoft.intellij.plugin.inno_setup.build.IsBuildToolWindowFactory"/>
        <notificationGroup id="Inno Setup" displayType="BALLOON"/>

        <!-- Inlay hints: language flags for [Languages]/[LangOptions], and #include content preview -->
        <codeInsight.inlayProvider language="ISS"
                                   implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.feature.editor.section.IsSectionLanguageInlayHintsProvider"/>
        <codeInsight.inlayProvider language="ISS"
                                   implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.feature.editor.preprocessor.IsIncludeContentInlayHintsProvider"/>

        <!-- Find Usages -->
        <lang.findUsagesProvider language="ISS"
                                 implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.feature.find.IsSectionFindUsagesProvider"/>
        <lang.findUsagesProvider language="ISPP"
                                 implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.feature.find.IsPreprocessorFindUsagesProvider"/>

        <!-- Refactoring: inline rename -->
        <lang.refactoringSupport language="ISS"
                                 implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.feature.find.IsSectionRefactoringSupportProvider"/>
        <lang.refactoringSupport language="ISPP"
                                 implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.feature.find.IsPreprocessorRefactoringSupportProvider"/>

        <statementUpDownMover
                implementation="org.pcsoft.intellij.plugin.inno_setup.language.feature.editor.section.IsSectionMover"/>

        <!-- Completion -->
        <completion.contributor language="ISS"
                                implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.feature.completion.IsSectionCompletionContributor"/>
        <completion.contributor language="ISPP"
                                implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.feature.completion.IsPreprocessorCompletionContributor"/>
        <completion.contributor language="IST"
                                implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.feature.completion.IsTemplateCompletionContributor"/>

        <!-- Rename / Find Usages searchers -->
        <referencesSearch
                implementation="org.pcsoft.intellij.plugin.inno_setup.language.feature.reference.IsPreprocessorReferencesSearcher"/>
        <referencesSearch
                implementation="org.pcsoft.intellij.plugin.inno_setup.language.feature.reference.IsSectionReferencesSearcher"/>
        <referencesSearch
                implementation="org.pcsoft.intellij.plugin.inno_setup.language.feature.reference.IsSectionCustomMessageReferencesSearcher"/>
        <referencesSearch
                implementation="org.pcsoft.intellij.plugin.inno_setup.language.feature.reference.IsSectionLanguagePrefixReferencesSearcher"/>

        <!-- Reference provider -->
        <psi.referenceContributor language="ISS"
                                  implementation="org.pcsoft.intellij.plugin.inno_setup.language.feature.reference.IsSectionReferenceContributor"/>

        <!-- Structure view + navigation bar -->
        <lang.psiStructureViewFactory language="ISS"
                                      implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.feature.editor.IsStructureViewFactory"/>
        <navbar implementation="org.pcsoft.intellij.plugin.inno_setup.language.feature.editor.IsStructureAwareNavbar"/>

        <!-- Breadcrumbs + sticky lines (the platform derives sticky lines from the breadcrumbs infrastructure) -->
        <breadcrumbsInfoProvider
                implementation="org.pcsoft.intellij.plugin.inno_setup.language.feature.editor.IsBreadcrumbsProvider"/>
        <fileBreadcrumbsCollector id="IsFileBreadcrumbsCollector" order="first"
                                  implementation="org.pcsoft.intellij.plugin.inno_setup.language.feature.editor.IsFileBreadcrumbsCollector"/>

        <!-- Documentation -->
        <lang.documentationProvider language="ISS"
                                    implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.feature.editor.section.IsSectionDocumentationProvider"/>
        <lang.documentationProvider language="ISPP"
                                    implementationClass="org.pcsoft.intellij.plugin.inno_setup.language.feature.editor.preprocessor.IsPreprocessorDocumentationProvider"/>

        <!-- Default colors for ISPP preprocessor highlighting (dark/light) -->
        <additionalTextAttributes scheme="Default" file="colorSchemes/IssDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/IssDarcula.xml"/>

        <!-- ═══════════════════════════════ Settings ═══════════════════════════════ -->
        <applicationConfigurable
                parentId="build"
                id="org.pcsoft.intellij.plugin.inno_setup.settings"
                key="settings.inno_setup.display_name" bundle="messages.PluginBundle"
                instance="org.pcsoft.intellij.plugin.inno_setup.settings.IsSettingsConfigurable"/>
        <projectConfigurable
                parentId="org.pcsoft.intellij.plugin.inno_setup.settings"
                id="org.pcsoft.intellij.plugin.inno_setup.settings.build"
                key="settings.build.display_name" bundle="messages.PluginBundle"
                instance="org.pcsoft.intellij.plugin.inno_setup.settings.IsBuildSettingsConfigurable"/>
        <applicationConfigurable
                parentId="org.pcsoft.intellij.plugin.inno_setup.settings"
                id="org.pcsoft.intellij.plugin.inno_setup.settings.editor"
                key="settings.editor.display_name" bundle="messages.PluginBundle"
                instance="org.pcsoft.intellij.plugin.inno_setup.settings.IsEditorSettingsConfigurable"/>

        <!-- ═══════════════════════════════ Build ═══════════════════════════════ -->
        <projectTaskRunner
                implementation="org.pcsoft.intellij.plugin.inno_setup.build.IsBuildProjectTaskRunner"/>
        <console.folding implementation="org.pcsoft.intellij.plugin.inno_setup.build.IsBuildOutputConsoleFolding"/>

        <!-- ═══════════════════════════════ Intentions ═══════════════════════════════ -->
        <intentionAction>
            <language>ISS</language>
            <className>
                org.pcsoft.intellij.plugin.inno_setup.language.feature.editor.section.IsParameterFlipIntentionAction
            </className>
        </intentionAction>
        <intentionAction>
            <language>ISS</language>
            <className>
                org.pcsoft.intellij.plugin.inno_setup.language.feature.editor.section.IsIncludeInlineIntentionAction
            </className>
        </intentionAction>
        <intentionAction>
            <language>ISS</language>
            <className>
                org.pcsoft.intellij.plugin.inno_setup.language.feature.editor.section.IsExtractIncludeIntentionAction
            </className>
        </intentionAction>

        <!-- ═══════════════════════════════ Run ═══════════════════════════════ -->
        <configurationType
                implementation="org.pcsoft.intellij.plugin.inno_setup.build.run.IsRunConfigurationType"/>
        <codeInsight.lineMarkerProvider
                language="ISS"
                implementationClass="org.pcsoft.intellij.plugin.inno_setup.build.gutter.IsSetupSectionGutterIconProvider"/>

        <!-- ═══════════════════════════ Build configurations ═══════════════════════════ -->
        <postStartupActivity
                implementation="org.pcsoft.intellij.plugin.inno_setup.build.config.IsBuildConfigurationStartupActivity"/>
        <editorNotificationProvider
                implementation="org.pcsoft.intellij.plugin.inno_setup.build.config.IsBuildConfigurationNotificationProvider"/>
    </extensions>

    <projectListeners>
        <listener class="org.pcsoft.intellij.plugin.inno_setup.build.config.IsRunConfigurationSelectionListener"
                  topic="com.intellij.execution.RunManagerListener"/>
    </projectListeners>

    <!-- Feeds the run configuration's ISCC /D symbols into the conditional-branch analysis, so the editor
         greys out the same #ifdef branches the build skips. -->
    <extensions defaultExtensionNs="org.pcsoft.intellij.plugin.inno_setup">
        <preprocessorSymbolProvider
                implementation="org.pcsoft.intellij.plugin.inno_setup.build.run.IsRunConfigurationSymbolProvider"/>
    </extensions>

    <!-- Action texts/descriptions are set in code via PluginBundle (see the action classes). -->
    <actions>
        <action id="Iss.NewFile"
                class="org.pcsoft.intellij.plugin.inno_setup.language.file_type.script.action.IsScriptCreateFileAction"
                icon="/icons/inno-setup-script-icon.svg">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFile"/>
        </action>
        <action id="Isl.NewFile"
                class="org.pcsoft.intellij.plugin.inno_setup.language.file_type.lang.action.IsLanguageCreateFileAction"
                icon="/icons/inno-setup-lang-icon.svg">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="Iss.NewFile"/>
        </action>
        <action id="Ist.NewFile"
                class="org.pcsoft.intellij.plugin.inno_setup.language.file_type.template.action.IsTemplateCreateFileAction"
                icon="/icons/inno-setup-template-icon.svg">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="Isl.NewFile"/>
        </action>

        <!-- Submenus: one entry per build configuration, filled dynamically from the .build directory. -->
        <group id="Iss.RunScript"
               class="org.pcsoft.intellij.plugin.inno_setup.build.action.IsScriptRunGroup"
               icon="AllIcons.RunConfigurations.TestState.Run"
               popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="before"
                          relative-to-action="ProjectViewPopupMenuRunGroup"/>
            <add-to-group group-id="EditorPopupMenu" anchor="before" relative-to-action="EditorPopupMenu.Run"/>
        </group>

        <group id="Iss.BuildScript"
               class="org.pcsoft.intellij.plugin.inno_setup.build.action.IsScriptBuildGroup"
               icon="AllIcons.Actions.Compile"
               popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="Iss.RunScript"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Iss.RunScript"/>
        </group>

        <action id="Iss.ShowEffectiveScript"
                class="org.pcsoft.intellij.plugin.inno_setup.language.feature.include.action.IsShowEffectiveScriptAction">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
